{
  "prepare": [
    {
      "narration": "Resolve the selected header, body, and footer recipes.",
      "func": "resolveOptions",
      "inputPaths": [
        { "fileName": "data", "filePath": ["options"] }
      ],
      "destinationPath": { "fileName": "context", "filePath": ["selection"] }
    },
    {
      "narration": "Prepare the form fields and the values for the active record.",
      "func": "prepareFields",
      "inputPaths": [
        { "fileName": "data", "filePath": ["columns"] },
        { "fileName": "data", "filePath": ["records"] },
        { "fileName": "context", "filePath": ["selection"] }
      ],
      "destinationPath": { "fileName": "context", "filePath": ["fields"] }
    },
    {
      "narration": "Resolve the selected framework classes for the card and its sections.",
      "func": "resolveClasses",
      "inputPaths": [
        { "fileName": "context", "filePath": ["selection"] }
      ],
      "destinationPath": { "fileName": "context", "filePath": ["templateValues"] }
    }
  ],
  "build": [
    {
      "narration": "Build the header actions into the base header slot.",
      "func": "fromCollection",
      "inputPaths": [
        { "fileName": "context", "filePath": ["selection", "header", "actions"] },
        { "fileName": "spec", "filePath": ["button"] }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "header-actions",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    },
    {
      "narration": "Build the form fields into the base body slot.",
      "func": "twoDimensional",
      "inputPaths": [
        { "fileName": "context", "filePath": ["fields", "columns"] },
        { "fileName": "context", "filePath": ["fields", "rows"] },
        { "fileName": "spec" }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "form-body",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    },
    {
      "narration": "Build the footer actions into the base footer slot.",
      "func": "fromCollection",
      "inputPaths": [
        { "fileName": "context", "filePath": ["selection", "footer", "actions"] },
        { "fileName": "spec", "filePath": ["button"] }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "footer-actions",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    }
  ],
  "style": [
    {
      "narration": "Apply the selected framework classes to the completed form.",
      "func": "applyTemplate",
      "inputPaths": [
        { "fileName": "context", "filePath": ["templateValues"] },
        { "fileName": "base" }
      ],
      "destinationPath": { "fileName": "base" }
    }
  ]
}
