{
  "tagName": "div",
  "attributes": {
    "class": "${cardClass}",
    "data-role": "form-card"
  },
  "children": [
    {
      "tagName": "header",
      "attributes": {
        "class": "${headerClass}",
        "data-role": "form-header"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": { "class": "${headingClass}" },
          "children": [
            {
              "tagName": "h2",
              "textContent": "${title}",
              "attributes": { "class": "${titleClass}" }
            },
            {
              "tagName": "p",
              "textContent": "${description}",
              "attributes": { "class": "${descriptionClass}" }
            }
          ]
        },
        {
          "tagName": "span",
          "textContent": "${recordId}",
          "attributes": {
            "class": "${recordIdClass}",
            "data-role": "record-id"
          }
        },
        {
          "tagName": "div",
          "attributes": {
            "class": "${headerActionsClass}",
            "data-role": "header-actions"
          },
          "children": []
        }
      ]
    },
    {
      "tagName": "div",
      "attributes": { "class": "${cardBodyClass}", "data-role": "form-content" },
      "children": [
        {
          "tagName": "form",
          "attributes": {
            "id": "${formId}",
            "data-role": "form-body"
          },
          "children": []
        }
      ]
    },
    {
      "tagName": "footer",
      "attributes": {
        "class": "${footerClass}",
        "data-role": "form-footer"
      },
      "children": [
        {
          "tagName": "div",
          "attributes": {
            "class": "${footerActionsClass}",
            "data-role": "footer-actions"
          },
          "children": []
        }
      ]
    }
  ]
}
