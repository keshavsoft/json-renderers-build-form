{
  "form": {
    "tagName": "form",
    "attributes": {
      "class": "vstack gap-3",
      "id": "formWithButtonsId"
    },
    "children": []
  },
  "buttonBar": {
    "tagName": "div",
    "attributes": {
      "class": "d-flex align-items-center gap-2 mt-3"
    },
    "children": [
      {
        "tagName": "button",
        "textContent": "Submit",
        "attributes": {
          "type": "submit",
          "class": "btn btn-primary",
          "id": "submitBtnId"
        }
      },
      {
        "tagName": "button",
        "textContent": "Cancel",
        "attributes": {
          "type": "button",
          "class": "btn btn-secondary",
          "id": "cancelBtnId"
        }
      }
    ]
  }
}
