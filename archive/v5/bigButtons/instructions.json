{
  "build": [
    {
      "narration": "Build the header actions into the base header slot.",
      "func": "fromCollection",
      "inputPaths": [
        { "fileName": "data", "filePath": ["headerActions"] },
        { "fileName": "spec", "filePath": ["button"] }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "header-actions",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    },
    {
      "narration": "Build the form fields into the base body slot.",
      "func": "twoDimensional",
      "inputPaths": [
        { "fileName": "data", "filePath": ["columns"] },
        { "fileName": "data", "filePath": ["rows"] },
        { "fileName": "spec" }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "form-body",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    },
    {
      "narration": "Build the footer actions into the base footer slot.",
      "func": "fromCollection",
      "inputPaths": [
        { "fileName": "data", "filePath": ["footerActions"] },
        { "fileName": "spec", "filePath": ["button"] }
      ],
      "destinationPath": {
        "fileName": "base",
        "dataRole": "footer-actions",
        "filePath": ["children"],
        "action": "push"
      },
      "skipIfEmpty": true
    }
  ],
  "style": [
    {
      "narration": "Apply the selected framework classes to the completed form.",
      "func": "applyTemplate",
      "inputPaths": [
        { "fileName": "context", "filePath": ["templateValues"] },
        { "fileName": "base" }
      ],
      "destinationPath": { "fileName": "base" }
    }
  ]
}
